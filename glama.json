{
  "$schema": "https://glama.ai/mcp/schemas/server.json",
  "name": "nexus-mcp-ci",
  "description": "Local MCP server for AI coding agents: hybrid code search, static call graph and project memory. 8 tools that answer code questions in fewer agent turns. No API keys.",
  "pythonVersion": "3.12",
  "homepage": "https://github.com/jaggernaut007/Nexus-MCP",
  "repository": "https://github.com/jaggernaut007/Nexus-MCP",
  "maintainers": [
    "jaggernaut007"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "NEXUS_LOG_LEVEL": {
        "type": "string",
        "description": "Logging level (DEBUG, INFO, WARNING, ERROR)",
        "default": "INFO"
      },
      "NEXUS_LOG_FORMAT": {
        "type": "string",
        "description": "Log format: text or json",
        "default": "text"
      },
      "NEXUS_SEARCH_MODE": {
        "type": "string",
        "description": "Search mode: hybrid, vector, or bm25",
        "default": "hybrid"
      },
      "NEXUS_STORAGE_DIR": {
        "type": "string",
        "description": "Storage directory for indexes",
        "default": ".nexus"
      },
      "NEXUS_MAX_MEMORY_MB": {
        "type": "string",
        "description": "Memory budget in MB (about 90 MB idle, 460 MB with the embedding model loaded)",
        "default": "350"
      },
      "NEXUS_CHUNK_MAX_CHARS": {
        "type": "string",
        "description": "Max code snippet size per chunk",
        "default": "4000"
      },
      "NEXUS_EMBEDDING_MODEL": {
        "type": "string",
        "description": "Embedding model (bge-small-en)",
        "default": "bge-small-en"
      },
      "NEXUS_EMBEDDING_DEVICE": {
        "type": "string",
        "description": "Device for embeddings: auto, cuda, mps, cpu",
        "default": "auto"
      },
      "NEXUS_MAX_FILE_SIZE_MB": {
        "type": "string",
        "description": "Skip files larger than this",
        "default": "10"
      },
      "NEXUS_FUSION_WEIGHT_BM25": {
        "type": "string",
        "description": "BM25 engine weight in RRF",
        "default": "0.3"
      },
      "NEXUS_FUSION_WEIGHT_VECTOR": {
        "type": "string",
        "description": "Vector engine weight in RRF",
        "default": "0.5"
      }
    }
  },
  "keywords": [
    "code-search",
    "semantic-search",
    "hybrid-search",
    "code-graph",
    "mcp",
    "lancedb",
    "tree-sitter",
    "ast-grep",
    "call-graph",
    "project-memory",
    "claude-code",
    "ai-coding-agent"
  ]
}
